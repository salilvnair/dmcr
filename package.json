{
  "name": "dmcr",
  "displayName": "dmcr",
  "icon": "images/dmcr_bot.png",
  "description": "DMCR is a VS Code Copilot Chat participant (@dmcr) that helps you create database management change folders in a DMCR-style format.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "extensionDependencies": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "salilvnair.copilot.dmcr",
        "name": "dmcr",
        "fullName": "Dmcr",
        "description": "Copilot-powered DMCR assistant",
        "isSticky": true,
        "commands": []
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dmcr",
          "title": "DMCR Change Builder",
          "icon": "images/dmcr_bot_side.png"
        }
      ]
    },
    "views": {
      "dmcr": [
        {
          "id": "dmcr.canvasView",
          "name": "Quick Access",
          "type": "webview",
          "icon": "images/dmcr_bot.png",
          "visibility": "visible",
          "initialSize": 3
        },
        {
          "id": "dmcr.schemaExplorer",
          "name": "Schema Explorer",
          "type": "webview",
          "icon": "images/dmcr_bot.png",
          "when": "dmcr.hasDbMcp",
          "initialSize": 4
        },
        {
          "id": "dmcr.wikiView",
          "name": "Quick Reference",
          "type": "webview",
          "icon": "images/dmcr_bot.png",
          "initialSize": 7
        }
      ]
    },
    "commands": [
      {
        "command": "dmcr.open",
        "title": "DMCR: Open Change Builder",
        "icon": "$(database)",
        "category": "DMCR"
      },
      {
        "command": "dmcr.changeDbLocation",
        "title": "DMCR: Change Database Location",
        "icon": "$(folder-opened)",
        "category": "DMCR"
      },
      {
        "command": "dmcr.schemaExplorer.refresh",
        "title": "DMCR: Refresh Schema Explorer",
        "icon": "$(refresh)",
        "category": "DMCR"
      },
      {
        "command": "dmcr.openSchemaExplorer",
        "title": "DMCR: Open Schema Explorer",
        "icon": "$(database)",
        "category": "DMCR"
      },
      {
        "command": "dmcr.conversation",
        "title": "DMCR: Open Conversation",
        "icon": "$(comment-discussion)",
        "category": "DMCR"
      },
      {
        "command": "dmcr.openCopilotChat",
        "title": "DMCR: Open Copilot Chat with @dmcr",
        "icon": "$(copilot)",
        "category": "DMCR"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dmcr.schemaExplorer.refresh",
          "when": "view == dmcr.schemaExplorer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "DMCR",
      "properties": {
        "dmcr.changesDir": {
          "type": "string",
          "default": "db/changes",
          "description": "Relative path (from workspace root) where DMCR change folders are created."
        },
        "dmcr.idWidth": {
          "type": "number",
          "default": 3,
          "description": "Zero-pad width for the numeric prefix of change folder names (e.g. 3 → 001_...)."
        },
        "dmcr.copilotFamily": {
          "type": "string",
          "default": "",
          "description": "Default GitHub Copilot model family for DMCR generation (e.g. gpt-4o, claude-sonnet). Leave blank to use extension default."
        },
        "dmcr.dbPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the DMCR SQLite database file. Leave blank to use the default location: ~/.dmcr/db/dmcr.db. Changes take effect immediately without restarting VS Code."
        },
        "dmcr.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to dmcr.ps1 (the PowerShell runner). When set, the DMCR Runner tab spawns this script directly. Leave blank to auto-detect (looks for dmcr.ps1 in the workspace root and common sibling locations)."
        },
        "dmcr.pwshPath": {
          "type": "string",
          "default": "",
          "description": "Path to PowerShell executable (pwsh or powershell). Leave blank for auto-detect (tries 'pwsh' then 'powershell')."
        },
        "dmcr.gitRemoteUrl": {
          "type": "string",
          "default": "",
          "description": "GitHub/Git remote URL for auto-commit and /sync. Example: https://github.com/org/repo.git"
        },
        "dmcr.gitAutoCommit": {
          "type": "boolean",
          "default": false,
          "description": "Automatically git add, commit (AI message), and push after every successful change generation."
        },
        "dmcr.gitBranch": {
          "type": "string",
          "default": "",
          "description": "Target branch for git push/pull. Leave empty to use the currently checked-out branch."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build:webview": "vite build --config vite.webview.config.ts",
    "dev:webview": "vite --config vite.webview.config.ts",
    "build:dui": "cd ../dui && npm run build:css",
    "build:all": "npm run build:dui && npm run build:webview && npm run check-types && node esbuild.js",
    "vsix": "npm run build:webview && npm run package && vsce package --no-dependencies"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@salilvnair/convengine-chat": "^1.0.7",
    "@salilvnair/dui": "file:../dui",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ansi-to-html": "^0.7.2",
    "libpg-query": "^17.7.3",
    "node-sql-parser": "^5.4.0",
    "react-arborist": "^3.6.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/node-sql-parser": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.103.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^6.3.3"
  }
}
